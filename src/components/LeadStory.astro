---
import type { RssStory } from '../data/types';
interface Props {
  story: RssStory;
}
const { story } = Astro.props;
---
<article class="lead-story">
  <h2 class="section-label">Lead · From the wires</h2>
  <h2>
    <a href={story.url} target="_blank" rel="noopener noreferrer">{story.title}</a>
  </h2>
  <p class="lead-deck">{story.description}</p>
  <div class="lead-meta">{story.source} · {story.category}</div>
  <div class="image-placeholder" role="img" aria-label="Lead image placeholder">
    {story.image ? 'Image' : 'Image placeholder'} · RSS enclosure later
  </div>
</article>
