---
import type { WeatherConfig } from '../data/types';
interface Props {
  weather: WeatherConfig;
}
const { weather } = Astro.props;
const iframeSrc = weather.embedSrc || null;
---
<section class="weather-widget" aria-label="Weather" data-weather-root data-default-zip={weather.zip}>
  <h2 class="section-label">Weather · <span data-weather-label>{weather.locationLabel}</span></h2>
  {iframeSrc ? (
    <iframe
      class="wu-frame"
      title={`Weather Underground — ${weather.locationLabel}`}
      src={iframeSrc}
      loading="lazy"
      referrerpolicy="no-referrer-when-downgrade"
    ></iframe>
  ) : (
    <div class="wu-embed-scaffold">
      WU widget slot — set <code>weather.embedSrc</code> for an official embed. Until then, use the strip + link below.
    </div>
  )}
  <div class="weather-fallback">
    <div class="temps">{weather.fallback.highF}° / {weather.fallback.lowF}°</div>
    <div>{weather.fallback.summary} · ZIP <span data-weather-zip>{weather.zip}</span></div>
    <a
      data-weather-link
      href={weather.wundergroundUrl}
      target="_blank"
      rel="noopener noreferrer"
    >
      Weather Underground forecast →
    </a>
  </div>
</section>
