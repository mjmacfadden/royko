---
import type { WeatherConfig } from '../data/types';
interface Props {
  weather: WeatherConfig;
}
const { weather } = Astro.props;
/** Default Northbrook forecast7 embed; client updates from Settings ZIP. */
const widgetHref = 'https://forecast7.com/en/42d13n87d83/northbrook/';
/**
 * weatherwidget.io: flat "pure" theme + zero-alpha fills.
 * Cross-origin iframe may still paint opaque white internally; CSS mix-blend-mode
 * on the frame knocks white out against cream paper as a practical workaround.
 */
const theme = 'pure';
const basecolor = 'rgba(0,0,0,0)';
const textcolor = '#1a1a1a';
const accent = 'rgba(0,0,0,0)';
---
<section class="weather-strip" aria-label="Weather" data-weather-root data-default-zip={weather.zip}>
  <!-- Screen: weatherwidget.io interactive embed (below masthead) -->
  <div class="weather-widget-live screen-only">
    <a
      class="weatherwidget-io"
      href={widgetHref}
      data-label_1="NORTHBROOK"
      data-label_2="WEATHER"
      data-theme={theme}
      data-basecolor={basecolor}
      data-textcolor={textcolor}
      data-highcolor={textcolor}
      data-lowcolor="#444444"
      data-accent={accent}
      data-days="5"
      >NORTHBROOK WEATHER</a
    >
    <p class="weather-widget-status" data-weather-status hidden></p>
  </div>

  <!-- Print / fallback: compact high-low + optional Grok prose -->
  <div class="weather-fallback" data-weather-print>
    <h2 class="section-label">Weather · <span data-weather-label>{weather.locationLabel}</span></h2>
    <div class="temps">{weather.fallback.highF}° / {weather.fallback.lowF}°</div>
    <div class="weather-fallback-summary" data-weather-summary>
      {weather.fallback.summary} · ZIP <span data-weather-zip>{weather.zip}</span>
    </div>
    <p class="weather-print-grok" data-print-weather-body hidden></p>
  </div>
</section>

<script is:inline>
!function(d,s,id){var js,fjs=d.getElementsByTagName(s)[0];if(!d.getElementById(id)){js=d.createElement(s);js.id=id;js.src='https://weatherwidget.io/js/widget.min.js';fjs.parentNode.insertBefore(js,fjs);}}(document,'script','weatherwidget-io-js');
</script>
