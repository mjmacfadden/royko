---
import { NEWS_FEEDS } from '../data/feeds';
import { COMIC_FEEDS } from '../data/feeds/comics';
const feedsBySection = {
  news: NEWS_FEEDS.filter((f) => f.section === 'news' || f.section === 'lead' || f.section === 'alsoToday'),
  businessTech: NEWS_FEEDS.filter((f) => f.section === 'businessTech'),
  sports: NEWS_FEEDS.filter((f) => f.section === 'sports'),
};
---
<dialog class="settings-dialog screen-only" id="settings-dialog" aria-labelledby="settings-title">
  <form method="dialog" class="settings-form" id="settings-form">
    <header class="settings-header">
      <h2 id="settings-title">Paper settings</h2>
      <button type="submit" class="settings-close" value="cancel" aria-label="Close">×</button>
    </header>

    <section class="settings-section">
      <h3>Weather ZIP</h3>
      <label class="settings-label">
        ZIP code
        <input type="text" name="zip" id="settings-zip" inputmode="numeric" pattern="[0-9]{5}" maxlength="5" value="60062" />
      </label>
      <p class="settings-help">Default 60062 (Northbrook). Updates the Weather Underground link.</p>
    </section>

    <section class="settings-section">
      <h3>Grok Automation brief</h3>
      <p class="settings-help">
        Canonical: <code>***Section***</code> headers, <code>**Headline**</code>, <code>*Named source: …*</code>, plain body.
        Weather/Markets = prose; What to watch = <code>-</code> bullets. Alternates: <code>##</code> sections and older <code>***hed***</code>.
        Interleaves with RSS as Brief cards — never a plain dump. See README “Paste format”.
      </p>
      <textarea id="grok-brief-input" class="grok-brief-textarea" rows="10" placeholder="***National &amp; World***&#10;&#10;**Headline**&#10;*Named source: Reuters, September 9*&#10;Body…"></textarea>
      <div class="grok-brief-actions">
        <button type="button" id="grok-brief-save">Save brief</button>
        <button type="button" id="grok-brief-clear">Clear</button>
        <button type="button" id="grok-brief-sample">Load sample</button>
      </div>
      <p class="settings-help" id="grok-brief-status" aria-live="polite"></p>
    </section>

    <section class="settings-section">
      <h3>Public calendars (ICS)</h3>
      <p class="settings-help">
        Paste Google Calendar <strong>public ICS / secret iCal address</strong> or any <code>.ics</code> URL.
        No login. Events for <strong>today</strong> (America/Chicago) merge into the agenda.
      </p>
      <div id="calendars-list" class="custom-feeds-list"></div>
      <div class="custom-feed-add calendar-add">
        <input type="text" id="calendar-label" placeholder="Label (e.g. Family)" />
        <input type="url" id="calendar-url" placeholder="https://calendar.google.com/calendar/ical/…/basic.ics" />
        <button type="button" id="calendar-add-btn">Add calendar</button>
      </div>
    </section>

    <section class="settings-section">
      <h3>Comics</h3>
      <p class="settings-help">Opt in/out. Up to 3 strips on the puzzles page (hotlink + credit).</p>
      <fieldset class="settings-comics">
        <legend>Sources</legend>
        {COMIC_FEEDS.map((c) => (
          <label class="settings-check">
            <input type="checkbox" name="comic" value={c.id} data-comic-id={c.id} />
            <span>{c.title} <em>({c.credit})</em></span>
          </label>
        ))}
      </fieldset>
    </section>

    <section class="settings-section">
      <h3>Built-in RSS feeds</h3>
      <p class="settings-help">Opt in/out. Items are filtered to today’s date (America/Chicago) when refreshing.</p>
      <div class="settings-feed-groups">
        <fieldset>
          <legend>News / lead</legend>
          {feedsBySection.news.map((f) => (
            <label class="settings-check">
              <input type="checkbox" name="feed" value={f.id} data-feed-id={f.id} />
              <span>{f.name}</span>
            </label>
          ))}
        </fieldset>
        <fieldset>
          <legend>Business · Tech</legend>
          {feedsBySection.businessTech.map((f) => (
            <label class="settings-check">
              <input type="checkbox" name="feed" value={f.id} data-feed-id={f.id} />
              <span>{f.name}</span>
            </label>
          ))}
        </fieldset>
        <fieldset>
          <legend>Sports</legend>
          {feedsBySection.sports.map((f) => (
            <label class="settings-check">
              <input type="checkbox" name="feed" value={f.id} data-feed-id={f.id} />
              <span>{f.name}</span>
            </label>
          ))}
        </fieldset>
      </div>
    </section>

    <section class="settings-section">
      <h3>Custom RSS feeds</h3>
      <p class="settings-help">Only items published <strong>today</strong> (America/Chicago) are included.</p>
      <div id="custom-feeds-list" class="custom-feeds-list"></div>
      <div class="custom-feed-add">
        <input type="text" id="custom-feed-name" placeholder="Name" />
        <input type="url" id="custom-feed-url" placeholder="https://example.com/feed.xml" />
        <button type="button" id="custom-feed-add-btn">Add feed</button>
      </div>
    </section>

    <footer class="settings-footer">
      <button type="button" id="settings-reset">Reset defaults</button>
      <button type="button" id="settings-save" class="primary">Save &amp; refresh</button>
    </footer>
    <p class="settings-status" id="settings-status" aria-live="polite"></p>
  </form>
</dialog>
