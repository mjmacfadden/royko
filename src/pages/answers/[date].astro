---
export const prerender = true;

import '../../styles/newspaper.css';
import { latestEdition } from '../../data/editions/latest';
import { puzzlesForDate } from '../../data/puzzles';
import { PAPER_NAME_UPPER, PAPER_TAGLINE } from '../../lib/site';

export function getStaticPaths() {
  return [{ params: { date: latestEdition.date } }];
}

const { date } = Astro.params;
const editionDate = new Date(`${date}T12:00:00`);
const puzzles = puzzlesForDate(editionDate);
const { crossword, jumble, trivia } = puzzles;

---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Puzzle answers — {date} · {PAPER_NAME_UPPER}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Libre+Franklin:wght@400;600;700&family=Manufacturing+Consent&family=Merriweather:ital,opsz,wght@0,18..144,300;0,18..144,400;0,18..144,700;1,18..144,300;1,18..144,400&family=Playfair+Display:wght@700;900&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="answers-page-body">
    <main class="answers-page">
      <header class="answers-header">
        <p class="answers-kicker">{PAPER_NAME_UPPER}</p>
        <h1>Today’s puzzle answers</h1>
        <p class="answers-date">{date}</p>
        <p class="answers-tagline">{PAPER_TAGLINE}</p>
        <p class="answers-spoiler">Spoilers below — finish the paper first.</p>
      </header>

      <section class="answers-section">
        <h2>Jumble</h2>
        <p class="answers-meta">{jumble.clue}</p>
        <p class="answers-scrambled">{jumble.scrambled}</p>
        <p class="answers-value"><strong>{jumble.answer}</strong></p>
      </section>

      <section class="answers-section">
        <h2>Sports trivia · {trivia.category}</h2>
        <p class="answers-meta">{trivia.question}</p>
        <p class="answers-value">{trivia.answer}</p>
      </section>

      <section class="answers-section">
        <h2>Crossword · {crossword.title}</h2>
        <div
          class="crossword-grid answers-crossword"
          style={`grid-template-columns: repeat(${crossword.size}, 1.6rem);`}
        >
          {crossword.solution.map((cell) => {
            const isBlock = cell === '.';
            return (
              <div class:list={['crossword-cell', { block: isBlock }]}>
                {!isBlock && <span class="answers-letter">{cell.toUpperCase()}</span>}
              </div>
            );
          })}
        </div>
        <ul class="answers-clue-list">
          {crossword.clues.map((c) => (
            <li>
              <strong>{c.num}{c.dir === 'across' ? 'A' : 'D'}</strong>: {c.answer.toUpperCase()}
              <span class="answers-meta"> — {c.clue}</span>
            </li>
          ))}
        </ul>
      </section>

      <p class="answers-back">
        <a href="/">← Back to the paper</a>
      </p>
    </main>
  </body>
</html>
